# Auth
AUTH_SECRET=generate-a-long-random-string
JOB_NOTIFY_MS=30000

# -----------------------------------------------------------------------------
# PlatformAI LLMaaS (OpenAI-compatible chat completions)
# Docs: https://platform.ai.tech.gov.sg/models#llmaas-api-reference
#
# LOCAL:  https://api.ai.tech.gov.sg/platform/models   (+ local key)
# VERCEL: https://api-public.ai.tech.gov.sg/platform/models  (+ public key)
# Put local values in .env.local; put Vercel values in the Vercel dashboard
# (or keep a private .env.vercel.local as a checklist — do not commit keys).
# -----------------------------------------------------------------------------
PLATFORM_AI_BASE_URL=https://api.ai.tech.gov.sg/platform/models
PLATFORM_AI_API_KEY=

# Model IDs must be enabled on THAT API key in PlatformAI → Select Models
AI_VISION_MODEL=ocns.claude-fable-5
AI_PHOTO_MODEL=ocns.claude-fable-5
AI_CHAT_MODEL=ocns.claude-fable-5

# Optional public OpenAI fallback
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=0
